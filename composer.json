{
  "name": "morphp/medas-http-file-server",
  "description": "Medas http file server",
  "keywords": [
    "http",
    "storage"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "ext-fileinfo": "*",
    "morphp/medas-core": "^4",
    "morphp/medas-files": "^3",
    "morphp/medas-http-client": "^3.4"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-events": "^3",
    "morphp/medas-file-system": "^3",
    "morphp/medas-http-file-client": "^4",
    "morphp/medas-json-storage": "^4",
    "morphp/medas-jwt-tokens": "^1",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "morphp/medas-storage-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\HttpFileServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\HttpFileServerTest\\": "tests/"
    }
  }
